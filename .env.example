APP_NAME=mcx9route
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Laravel v1 tidak butuh database
DB_CONNECTION=sqlite

# SESSION_DRIVER=file untuk Railway (tanpa database)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# CACHE_STORE=file untuk Railway (tanpa database)
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Konfigurasi 9Router (wajib) ---
# URL dasar instance 9Router, tanpa /v1
NINE_ROUTER_URL=https://9router.shendyrn-dev.blitz.cloud

# Path endpoint login (default: /api/auth/login)
NINE_ROUTER_LOGIN_PATH=/api/auth/login

# Nama field password di payload login (default: password)
# Periksa tab Network > Payload di browser saat login dashboard 9Router
NINE_ROUTER_LOGIN_FIELD=password

# Password login dashboard 9Router (WAJIB, jangan commit ke repo)
NINE_ROUTER_PASSWORD=

# Path endpoint stats (default: /api/usage/stats)
STATS_PATH=/api/usage/stats

# Path endpoint chart (default: /api/usage/chart)
CHART_PATH=/api/usage/chart

# --- Login untuk membuka mcx9route (wajib) ---
# Username login web (default: admin)
DASH_USER=admin

# Password login web (WAJIB, jangan commit ke repo)
DASH_PASSWORD=
